<!-- Static Joint -->
<joint name="camera_fixed_joint" type="fixed">
  <parent link="world"/>
  <child link="camera_link"/>
  <origin xyz="-2 0 1.5" rpy="0 0.5 0"/> <!-- Adjust position in the world -->
</joint>

<link name="grasp_frame">
  <visual>
    <geometry>
      <sphere radius="0.01"/>  <!-- Small sphere to visualize the frame -->
    </geometry>
    <material name="yellow">
      <color rgba="1.0 1.0 0.0 1.0"/>  <!-- Yellow to make it visible -->
    </material>
  </visual>
</link>

<joint name="grasp_frame_joint" type="fixed">
  <parent link="wrist3_link"/>
  <child link="grasp_frame"/>
  <origin xyz="0 0 0.32" rpy="0 0 0"/>  <!-- Adjust Z-axis to be between the fingers -->
</joint>

