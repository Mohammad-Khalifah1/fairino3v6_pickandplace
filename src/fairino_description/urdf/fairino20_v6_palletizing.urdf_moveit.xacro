<robot name="fr20v6_arm" xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:arg name="use_gazebo" default="false" />
  <xacro:arg name="use_ignition" default="false" />
  <xacro:arg name="use_fake_hardware" default="false" />
    <link name="world">
  </link>

  <joint
